[Unit]
Description=Lucebox model-name router for vLLM Swift and local GGUF models
Wants=network.target
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/lucebox
ExecStart=/opt/lucebox-python/bin/python /opt/lucebox/model_router.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=240

[Install]
WantedBy=multi-user.target
