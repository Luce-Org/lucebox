[Unit]
Description=80K PFlash compression proxy for the Swift vLLM backend
Wants=network.target vllm-swift-int4.service
After=network.target vllm-swift-int4.service

[Service]
Type=simple
WorkingDirectory=/opt/lucebox-concurrent/server
Environment=LD_LIBRARY_PATH=/opt/rocm/core-10.0/lib:/opt/rocm/lib
ExecStart=/opt/lucebox/work/concurrency-20260913/alternating-candidate/dflash_server \
  /code/models/swift-qwen/ukisai_Swift-Qwen3.8-27b-IQ4_XS.gguf \
  --host 192.168.2.191 \
  --port 8216 \
  --model-name ukisai/Swift-Qwen3.8-27b-int4-AMD \
  --max-ctx 80000 \
  --prefill-compression auto \
  --prefill-threshold 32000 \
  --prefill-keep-ratio 0.2 \
  --prefill-drafter /code/models/qwen38/Qwen3-0.6B-BF16.gguf \
  --prefill-skip-park \
  --prefill-upstream-base http://192.168.2.191:18218/v1 \
  --prefill-upstream-model ukisai/Swift-Qwen3.8-27b-int4-AMD
Restart=on-failure
RestartSec=3
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
